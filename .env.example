# 复制为项目根目录的 .env（勿提交含真实密钥的 .env）
#
# ── 代理（统一经本机 Clash，Mixed 端口默认 7890，须开启 Allow LAN）──
# 容器访问宿主机代理：host.docker.internal（见 docker/NETWORK.txt）
# 若在 .env 中显式写 DOCKER_HTTP_PROXY=（空值），则 compose 不注入代理（极少用）
DOCKER_HTTP_PROXY=http://host.docker.internal:7890
DOCKER_HTTPS_PROXY=http://host.docker.internal:7890
# 可选：覆盖 compose 内默认 NO_PROXY（逗号分隔）
# DOCKER_NO_PROXY=localhost,127.0.0.1,redis,chroma,postgres
#
# 可选：覆盖「兜底」基础镜像（compose 默认 DaoCloud 前缀，便于国内拉取；海外可改回官方名）
# PYTHON_BASE_IMAGE=python:3.11.8-slim-bullseye
# JAVA_BUILD_IMAGE=eclipse-temurin:17-jdk-jammy
# JAVA_RUN_IMAGE=eclipse-temurin:17-jre-jammy
# 可选：覆盖 PyPI 索引（Dockerfile 默认清华；构建期 pip 不走代理）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
#
# MCP web_fetch 允许抓取的域名（逗号分隔）；不设则使用 ai-service 内置默认白名单
# MCP_WEB_ALLOW_DOMAINS=python.org,github.com,stackoverflow.com

DEEPSEEK_API_KEY=sk-18bb807b76834b8fbb8a4f3ece0c2c79
SILICONFLOW_API_KEY=sk-sfmgjnkrtwriktzxiyqpnrjkhmtffhtaliigyvrtltivtmlm

# ── AI 服务核心配置 ──────────────────────────────────────────────────────
# Embedding 模型（默认硅基流动 bge-m3，可替换为其他 OpenAI 兼容接口）
# EMBEDDING_API_KEY=            # 不填则自动使用 SILICONFLOW_API_KEY
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# 嵌入前 token 计数：建议 true（用 tiktoken）；false 需额外安装 transformers
# EMBEDDING_TIKTOKEN_ENABLED=true

# Prompt 版本（qa_v1.yaml / qa_v2.yaml）
# PROMPT_QA_VERSION=v1

# ── 安全 & 限流（生产环境务必开启）────────────────────────────────────────
# 是否启用 API Key 鉴权（开启后需要在请求头携带 X-API-Key）
# API_KEY_ENABLED=true
# 合法的 API Key（逗号分隔，支持多 Key 轮换）
# API_KEYS=your-api-key-1,your-api-key-2

# 是否启用限流（Redis 滑动窗口）
# RATE_LIMIT_ENABLED=true
# 每个时间窗口内允许的最大请求数
# RATE_LIMIT_MAX_REQUESTS=60
# 时间窗口大小（秒）
# RATE_LIMIT_WINDOW_SECONDS=60

# 用户输入的最大字符数（Guardrails 防 Token 炸弹攻击）
# MAX_INPUT_LENGTH=4000

# ── LLM 可靠性（重试 + 超时 + 熔断）──────────────────────────────────────
# LLM 调用失败的最大重试次数（仅重试 429/5xx，不重试 400/401）
# LLM_MAX_RETRIES=3
# 重试等待最小/最大秒数（指数退避范围）
# LLM_RETRY_WAIT_MIN=1.0
# LLM_RETRY_WAIT_MAX=10.0
# 非流式 LLM 单次调用超时（秒）：用于 Planner 节点等
# LLM_INVOKE_TIMEOUT=60.0
# LangGraph 计划生成总超时（秒）：含多次 LLM + MCP 联网检索
# PLAN_TIMEOUT_SECONDS=120.0
# 流式 RAG 问答总超时（秒）：防止 LLM 挂起导致连接永久占用
# CHAT_STREAM_TIMEOUT=90.0
# 熔断器：连续失败 N 次后开路（默认 5 次）
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# 熔断器：开路后冷却时间（秒），冷却后自动进入半开状态试探
# CIRCUIT_BREAKER_RESET_TIMEOUT=30.0

# ── Token 配额（防恶意消耗 Token）────────────────────────────────────────
# 单 Session 在窗口内允许消耗的最大 Token 数（0 = 不限制，默认不限制）
# SESSION_TOKEN_BUDGET=50000
# Token 配额窗口大小（秒），窗口结束自动清零
# SESSION_TOKEN_WINDOW=3600

# ── RAG 检索配置 ──────────────────────────────────────────────────────────
# 是否启用 Embedding 重排序（提升检索精度，略增延迟）
# RERANK_ENABLED=true
# 初步召回候选数（BM25 + 向量各召回该数量）
# RETRIEVAL_CANDIDATES=12
# 重排后保留的最终文档数
# RERANK_TOP_N=4

# ── 缓存配置 ──────────────────────────────────────────────────────────────
# 精确缓存 TTL（秒）：相同问题的答案缓存时间
# CHAT_CACHE_TTL_SECONDS=3600
# 语义缓存距离阈值（越小越严格，0.42 为推荐值）
# SEMANTIC_CACHE_MAX_DISTANCE=0.42
# 是否启用语义缓存
# SEMANTIC_CACHE_ENABLED=true

# ── 会话记忆 ──────────────────────────────────────────────────────────────
# 会话历史保留的最大轮次
# CHAT_HISTORY_MAX_TURNS=10
# 是否启用长期记忆（跨会话向量化存储）
# LONG_MEMORY_ENABLED=false

# ── 可观测性（Langfuse）──────────────────────────────────────────────────
# 可选：配置后开启 LLM 调用追踪（不配置则自动跳过，不影响功能）
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── MCP 工具 ─────────────────────────────────────────────────────────────
# MCP web_fetch 允许抓取的域名（逗号分隔）；不设则使用 ai-service 内置默认白名单
# MCP_WEB_ALLOW_DOMAINS=python.org,github.com,stackoverflow.com
