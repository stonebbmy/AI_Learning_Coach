# -----------------------------------------------------------------------------
**/target/
*.class
*.jar
*.war
*.ear
*.iml
.idea/
*.log

# -----------------------------------------------------------------------------
# Python (ai-service)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

