# 复制为 ~/.wsl-proxy.env 后在 ~/.bashrc / ~/.zshrc 中 source
# WSL2 内访问 Windows 上的 Clash（需开启 Allow LAN；端口默认 7890）

export CLASH_PORT="${CLASH_PORT:-7890}"
# Windows 主机地址（WSL2 常用；若无效可改为 127.0.0.1 试镜像网络场景）
export WIN_HOST="${WIN_HOST:-$(grep -m1 '^nameserver' /etc/resolv.conf | awk '{print $2}')}"

export http_proxy="http://${WIN_HOST}:${CLASH_PORT}"
export https_proxy="http://${WIN_HOST}:${CLASH_PORT}"
export HTTP_PROXY="$http_proxy"
export HTTPS_PROXY="$https_proxy"
export ALL_PROXY="$http_proxy"
export all_proxy="$http_proxy"

export no_proxy="localhost,127.0.0.1,::1"
export NO_PROXY="$no_proxy"
