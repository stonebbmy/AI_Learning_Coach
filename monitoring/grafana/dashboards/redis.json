{
  "title": "Redis Monitoring",
  "uid": "aicoach-redis",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "连接的客户端数 (Connected Clients)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "内存使用 (Used Memory)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "unit": "bytes"
      },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used memory",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Key 命中率 (Keyspace Hit Rate)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "unit": "percentunit",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "red",    "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "green",  "value": 0.8 }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Key 总数 (Total Keys - DB0)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "redis_db_keys{db=\"db0\"}",
          "legendFormat": "keys in db0",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "内存使用趋势 (Memory Usage Over Time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "redis_memory_max_bytes",
          "legendFormat": "max",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "命令处理速率 (Commands Processed / s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "cmds/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Key 命中 vs 未命中趋势 (Hits vs Misses / s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[1m])",
          "legendFormat": "hits/s",
          "refId": "A"
        },
        {
          "expr": "rate(redis_keyspace_misses_total[1m])",
          "legendFormat": "misses/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "连接数趋势 (Connected Clients Over Time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "refId": "A"
        },
        {
          "expr": "redis_blocked_clients",
          "legendFormat": "blocked",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "过期 Key 速率 (Expired Keys / s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(redis_expired_keys_total[1m])",
          "legendFormat": "expired keys/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Redis 实例上线时长 (Uptime)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "redis_uptime_in_seconds",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ]
    }
  ]
}
